# ==============================================================================
# AI Interview Simulator - Environment Configuration
# ==============================================================================
# NOTE: Vite is configured with `envDir: '../'` in frontend/vite.config.ts, which
# means all frontend environment variables (prefixed with VITE_) MUST be placed
# in this root `.env` file for Vite to pick them up during development and build.
# ==============================================================================

# Supabase Authentication & Database
# Obtain these from your Supabase Project Settings -> API / Database
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...<your-anon-key>

# LLM Providers (for Interview Engine & Feedback)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

GEMINI_API_KEY=...
